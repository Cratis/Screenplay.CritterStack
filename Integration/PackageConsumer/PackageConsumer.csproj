<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <CritterStackPackageVersion Condition="'$(CritterStackPackageVersion)' == ''">9999.0.0</CritterStackPackageVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Cratis.CritterStack.Screenplay" Version="$(CritterStackPackageVersion)" />
    </ItemGroup>
</Project>
