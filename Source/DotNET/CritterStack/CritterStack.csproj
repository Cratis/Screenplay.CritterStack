<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.CritterStack.Screenplay</AssemblyName>
        <RootNamespace>Cratis.CritterStack.Screenplay</RootNamespace>
        <IsPackable>true</IsPackable>
        <IsTestProject>false</IsTestProject>
        <EnablePackageValidation>true</EnablePackageValidation>
        <PackageValidationBaselineVersion>0.22.0</PackageValidationBaselineVersion>
        <Description>Generates verified Cratis Screenplay definitions from Marten and Wolverine source</Description>
        <PackageTags>cratis;event-sourcing;cqrs;screenplay;marten;wolverine;critterstack;interop</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Cratis.Screenplay.Generation.Contracts" />
        <PackageReference Include="Cratis.Screenplay.Generation" />
        <PackageReference Include="Cratis.Screenplay.Generation.DotNet" />
        <PackageReference Include="Cratis.Screenplay.Generation.DotNet.Vogen" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    </ItemGroup>
</Project>
