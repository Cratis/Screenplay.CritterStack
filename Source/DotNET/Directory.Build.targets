<Project>
    <!-- Evaluate the final project opt-in after the project can override the inline-spec default. -->
    <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
        <OutputType>Exe</OutputType>
        <CratisSpecificationsSharedLifecycle>true</CratisSpecificationsSharedLifecycle>
        <CratisSpecificationsReadableNames>true</CratisSpecificationsReadableNames>
        <WarningsAsErrors>$(WarningsAsErrors);CRSPEC0001;CRSPEC0002;CRSPEC0003;CRSPEC0004;CRSPEC0005;CRSPEC0006;CRSPEC0007;CRSPEC0008;CRSPEC0009</WarningsAsErrors>
    </PropertyGroup>

    <ItemGroup Condition="'$(IsTestProject)' == 'true'">
        <!-- The package generates the xUnit v3 framework registration. Keep the adapter for IDE discovery. -->
        <PackageReference Include="Cratis.Specifications" />
        <PackageReference Include="Cratis.Specifications.XUnit.v3" />
        <PackageReference Include="xunit.v3.mtp-off" />
        <PackageReference Include="xunit.runner.visualstudio">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="NSubstitute" Condition="'$(DedicatedSpecsProject)' != 'true'" />
    </ItemGroup>

    <!--
        Strips the inline specs (when_*/, for_*/, given/ and Specs/ folders) from Release builds. This lives in
        Directory.Build.targets - not Directory.Build.props - because the SDK's default Compile items do not
        exist yet when the props evaluate, which would make the removes silent no-ops.
    -->
    <ItemGroup Condition="'$(Configuration)' == 'Release' AND '$(DedicatedSpecsProject)' != 'true'">
        <Compile Remove="$(MSBuildProjectDirectory)/**/when_*/**/*.cs" />
        <Compile Remove="$(MSBuildProjectDirectory)/**/for_*/**/*.cs" />
        <Compile Remove="$(MSBuildProjectDirectory)/**/given/**/*.cs" />
        <Compile Remove="$(MSBuildProjectDirectory)/Specs/*.cs" />
    </ItemGroup>
</Project>
