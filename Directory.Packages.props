<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Cratis -->
    <PackageVersion Include="Cratis.Screenplay" Version="6.7.0" />
    <PackageVersion Include="Cratis.Screenplay.Generation.Contracts" Version="0.20.0" />
    <PackageVersion Include="Cratis.Screenplay.Generation" Version="0.20.0" />
    <PackageVersion Include="Cratis.Screenplay.Generation.DotNet" Version="0.20.0" />
    <PackageVersion Include="Cratis.Screenplay.Generation.DotNet.Vogen" Version="0.20.0" />
    <!-- Canonical fixtures -->
    <PackageVersion Include="Marten" Version="9.58.0" />
    <PackageVersion Include="Vogen" Version="8.0.7" />
    <PackageVersion Include="WolverineFx" Version="6.63.0" />
    <PackageVersion Include="WolverineFx.Http" Version="6.63.0" />
    <PackageVersion Include="WolverineFx.Marten" Version="6.63.0" />
    <!-- Microsoft -->
    <PackageVersion Include="Microsoft.Build.Framework" Version="18.11.0" />
    <PackageVersion Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
    <PackageVersion Include="Microsoft.NET.StringTools" Version="18.11.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.403" />
    <!-- Analysis -->
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" NoWarn="NU5104" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.322" />
    <!-- Specs -->
    <PackageVersion Include="Cratis.Specifications" Version="5.2.3" />
    <PackageVersion Include="Cratis.Specifications.XUnit.v3" Version="5.2.3" />
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
  </ItemGroup>
</Project>